{
  // NOTE: This is the *transpilation* config. It intentionally has a wide `include` so that
  // tsx/esbuild and editors apply `experimentalDecorators` to every file they touch — test files
  // included. esbuild only applies a tsconfig's compilerOptions to files matched by `include`,
  // and memoria's decorators are legacy-style, so a test file outside `include` would silently be
  // compiled with stage-3 decorator semantics and blow up at runtime.
  //
  // Type *checking* is driven by tsconfig.typecheck.json, which narrows `include` to src only.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Strictness. NOTE: `strict` is spelled out because TypeScript 6+ defaults it to true; the flags
    // below are the ones this codebase is held to, and tsc 5.9 and 7 must agree on them.
    "strict": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "allowUnreachableCode": false,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    "newLine": "LF",

    "types": ["node"]
  },
  "include": [
    "packages/@memoria/*/src/**/*",
    "packages/@memoria/*/test/**/*",
    "test/**/*",
    "scripts/**/*",
    "sketchpad.ts"
  ],
  "exclude": ["node_modules", "**/dist/**"]
}
