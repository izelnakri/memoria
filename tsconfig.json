{
  // NOTE: This is the *transpilation* config. It intentionally has a wide `include` so that
  // tsx/esbuild and editors apply `experimentalDecorators` to every file they touch — test files
  // included. esbuild only applies a tsconfig's compilerOptions to files matched by `include`,
  // and memoria's decorators are legacy-style, so a test file outside `include` would silently be
  // compiled with stage-3 decorator semantics and blow up at runtime.
  //
  // Type *checking* is driven by tsconfig.typecheck.json, which narrows `include` to src only.
  "typedocOptions": {
    "entryPoints": ["packages/@memoria/model/src/index.ts", "packages/@memoria/adapters/src/index.ts"],
    "out": "docs/api"
  },
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "declaration": true,
    "outDir": "./dist",
    "inlineSourceMap": true,
    "inlineSources": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": "./",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // Strictness
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitThis": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "allowUnreachableCode": false,
    "noImplicitReturns": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,

    "newLine": "LF",

    "paths": {
      "@memoria/adapters": ["packages/@memoria/adapters/src"],
      "@memoria/adapters/sql": ["packages/@memoria/adapters/src/sql/index.ts"],
      "@memoria/model": ["packages/@memoria/model/src"],
      "@memoria/response": ["packages/@memoria/response/src"],
      "@memoria/server": ["packages/@memoria/server/src"]
    },

    "types": ["node"]
  },
  "include": ["packages/@memoria/*/src/**/*", "packages/@memoria/*/test/**/*", "test/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "**/dist/**"]
}
