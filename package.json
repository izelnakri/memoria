{
  "name": "memoria",
  "private": true,
  "type": "module",
  "version": "0.0.33",
  "description": "in-memory database/ORM and http mock server you can run in-browser and node environments. Built for large frontend teams, fast tests and rapid prototyping",
  "author": "Izel Nakri",
  "repository": {
    "type": "git",
    "url": "https://github.com/izelnakri/memoria.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/@memoria/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/change-entrypoints.js ts && npm run libs:build",
    "build:dev": "ENVIRONMENT=development npm run libs:build",
    "changelog:unreleased": "node scripts/change-entrypoints.js js && auto-changelog --stdout --commit-limit false --package --unreleased-only --hide-credit",
    "changelog:preview": "node scripts/change-entrypoints.js js && auto-changelog --stdout --commit-limit false -u --hide-credit",
    "changelog:update": "node scripts/change-entrypoints.js js && auto-changelog --commit-limit false --package --hide-credit",
    "libs:build": "node scripts/clean-libraries.js && node scripts/build-libraries.js",
    "libs:clean": "node scripts/clean-libraries.js",
    "libs:release": "node scripts/release-libraries.js",
    "docs": "typedoc",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepack": "npm run build",
    "release": "release-it",
    "release:beta": "release-it --preRelease=beta",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node --import tsx --import ./test/helpers/setup-node-environment.ts --test test/index.ts",
    "test:node:watch": "node --import tsx --import ./test/helpers/setup-node-environment.ts --test --watch test/index.ts",
    "test:node:coverage": "c8 --reporter=lcov --reporter=text npm run test:node",
    "test:browser": "qunitx test/browser.ts --before=packages/@memoria/server/test/helpers/webserver-for-passthrough.js",
    "test:browser:watch": "npm run test:browser -- --watch",
    "test:browser:debug": "npm run test:browser -- --debug --open",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "fake-xml-http-request": "^2.1.2",
    "inflected": "^2.1.0",
    "kleur": "4.1.5",
    "pretender": "^3.4.7",
    "route-recognizer": "^0.3.4"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.1.1",
    "auto-changelog": "^2.6.0",
    "c8": "^12.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jquery": "^4.0.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "qunitx": "^1.2.18",
    "qunitx-cli": "^0.31.1",
    "recursive-lookup": "^1.0.0",
    "release-it": "^20.2.1",
    "rfdc": "^1.4.1",
    "sinon": "^22.1.0",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typeorm": "^0.3.31",
    "typescript": "5.9"
  },
  "prettier": {
    "printWidth": 120,
    "arrowParens": "always"
  },
  "volta": {
    "node": "24.14.0"
  },
  "release-it": {
    "npm": false,
    "publishConfig": {
      "access": "public"
    },
    "git": {
      "changelog": "npm run changelog:unreleased"
    },
    "github": {
      "release": true
    },
    "hooks": {
      "after:bump": "npm run changelog:update && npm run libs:release ${version}"
    }
  }
}
