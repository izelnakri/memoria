{
  "name": "memoria",
  "private": true,
  "type": "module",
  "version": "0.0.33",
  "description": "in-memory database/ORM and http mock server you can run in-browser and node environments. Built for large frontend teams, fast tests and rapid prototyping",
  "author": "Izel Nakri",
  "repository": {
    "type": "git",
    "url": "https://github.com/izelnakri/memoria.git"
  },
  "license": "MIT",
  "workspaces": [
    "packages/@memoria/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "changelog:latest": "git-cliff --latest --strip all",
    "changelog:preview": "git-cliff --unreleased",
    "changelog:update": "git-cliff --unreleased --prepend CHANGELOG.md",
    "clean": "rm -rf packages/@memoria/*/dist tmp/types coverage",
    "format": "prettier --check . \"!CHANGELOG.md\" \"!package-lock.json\"",
    "format:fix": "prettier --write . \"!CHANGELOG.md\" \"!package-lock.json\"",
    "sketchpad": "node --import tsx sketchpad.ts",
    "test": "npm run test:node && npm run test:browser",
    "test:browser": "qunitx test/browser.ts --before=packages/@memoria/server/test/helpers/webserver-for-passthrough.js",
    "test:browser:debug": "npm run test:browser -- --debug --open",
    "test:browser:watch": "npm run test:browser -- --watch",
    "test:node": "node --import tsx --import ./test/helpers/setup-node-environment.ts --test test/index.ts",
    "test:node:coverage": "c8 --reporter=lcov --reporter=text npm run test:node",
    "test:node:watch": "node --import tsx --import ./test/helpers/setup-node-environment.ts --test --watch test/index.ts",
    "test:release": "bash scripts/test-release.sh",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@types/jquery": "^4.0.1",
    "@types/node": "^26.1.1",
    "c8": "^12.0.0",
    "cors": "^2.8.6",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "git-cliff": "^2.14.2",
    "jquery": "^4.0.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "qunitx": "^1.4.0",
    "qunitx-cli": "^0.39.0",
    "rfdc": "^1.4.1",
    "sinon": "^22.1.0",
    "tsx": "^4.23.1",
    "typeorm": "^0.3.31",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "qunitx-cli": false
  },
  "prettier": {
    "printWidth": 120,
    "arrowParens": "always"
  },
  "volta": {
    "node": "24.22.0"
  }
}
